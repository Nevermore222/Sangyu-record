{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sangyu-record.local/contracts/skill-runner/v1/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["invocation_id", "status", "output", "evidence_refs", "warnings", "metrics", "error"],
  "properties": {
    "invocation_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["succeeded", "failed"] },
    "output": { "type": "object" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "metrics": { "type": "object" },
    "error": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      ]
    }
  }
}
