{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sangyu-record.local/contracts/skill-runner/v1/invocation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["invocation_id", "contract_version", "skill", "input", "allowed_resources", "deadline"],
  "properties": {
    "invocation_id": { "type": "string", "minLength": 1 },
    "contract_version": { "const": "1.0" },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "input": { "type": "object" },
    "allowed_resources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "deadline": { "type": "string", "format": "date-time" }
  }
}
