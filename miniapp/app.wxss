page {
  --ink: #252a27;
  --muted: #656b66;
  --canvas: #f4f5f3;
  --surface: #ffffff;
  --line: #dfe2df;
  --burgundy: #7d2f2a;
  --green: #315e4c;
  min-height: 100%;
  background: var(--canvas);
  color: var(--ink);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  letter-spacing: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 180rpx;
  background: var(--surface);
  box-sizing: border-box;
}

.page-head { margin: 8rpx 0 40rpx; }
.page-title { display: block; color: var(--ink); font-family: "Songti SC", "STSong", serif; font-size: 48rpx; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; }
.page-meta { display: block; margin-top: 10rpx; color: var(--muted); font-size: 25rpx; line-height: 1.5; }
.section-title { display: block; margin: 38rpx 0 16rpx; color: var(--ink); font-size: 27rpx; font-weight: 600; }

.row { display: flex; align-items: center; min-height: 104rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); box-sizing: border-box; }
.row:active { background: #f7f8f7; }
.row-main { flex: 1; min-width: 0; }
.row-title { display: block; font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
.row-subtitle { display: block; margin-top: 8rpx; color: var(--muted); font-size: 24rpx; line-height: 1.5; overflow-wrap: anywhere; }
.status { flex: 0 0 auto; margin-left: 20rpx; color: var(--burgundy); font-size: 24rpx; }

.empty, .error, .loading { padding: 96rpx 20rpx; color: var(--muted); text-align: center; line-height: 1.7; }
.error { color: var(--burgundy); }
.action-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 10; display: flex; gap: 20rpx; min-height: 128rpx; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: rgba(255, 255, 255, 0.97); box-sizing: border-box; }

button { height: 88rpx; border-radius: 6rpx; font-size: 28rpx; line-height: 88rpx; }
button::after { border: 0; }
button:active { opacity: 0.82; }
button[disabled] { opacity: 0.42; }
.primary { flex: 1; background: var(--ink); color: #fff; }
.secondary { flex: 1; border: 1rpx solid var(--ink); background: var(--surface); color: var(--ink); }

.field { padding: 22rpx 0; border-bottom: 1rpx solid var(--line); }
.field-label { display: block; margin-bottom: 12rpx; color: var(--muted); font-size: 24rpx; }
input, picker, textarea { min-height: 64rpx; color: var(--ink); font-size: 30rpx; }
