.result-page { background: var(--paper); padding-top: 24rpx; }
.result-hero { position: relative; overflow: hidden; min-height: 300rpx; margin: -24rpx -32rpx 0; }
.result-backdrop { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
.result-hero__shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(247, 242, 231, 0.84); pointer-events: none; }
.result-head { position: relative; z-index: 1; padding: 42rpx 32rpx 38rpx; }
.result-kicker { display: block; margin-bottom: 14rpx; color: var(--burgundy); font-size: 23rpx; }
.result-meta { display: block; margin-top: 12rpx; color: var(--muted); font-size: 24rpx; }
.book-preview { position: relative; overflow: hidden; width: 430rpx; aspect-ratio: 0.72; margin: 46rpx auto; border: 2rpx solid var(--ink); border-left: 18rpx solid var(--burgundy); border-radius: 4rpx; background: #fff; box-sizing: border-box; box-shadow: 12rpx 14rpx 0 #dedbd2; }
.book-paper { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; opacity: 0.42; pointer-events: none; }
.book-content { position: relative; z-index: 1; height: 100%; padding: 76rpx 50rpx; box-sizing: border-box; }
.book-rule { width: 64rpx; height: 3rpx; margin-bottom: 34rpx; background: var(--green); }
.book-title { display: block; font-family: "Songti SC", serif; font-size: 52rpx; font-weight: 600; line-height: 1.35; overflow-wrap: anywhere; }
.book-edition { display: block; margin-top: 22rpx; color: var(--muted); font-family: "Songti SC", serif; font-size: 25rpx; }
.book-seal { position: absolute; right: 42rpx; bottom: 54rpx; display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border: 3rpx solid var(--burgundy); color: var(--burgundy); font-family: "Songti SC", serif; font-size: 18rpx; line-height: 1.2; text-align: center; }
.delivery-row { display: flex; justify-content: space-between; min-height: 86rpx; align-items: center; border-bottom: 1rpx solid var(--line); color: var(--muted); font-size: 25rpx; }
.delivery-row text:last-child { color: var(--ink); }
