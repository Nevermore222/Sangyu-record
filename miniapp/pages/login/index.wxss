.login-page {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  min-height: 100vh;
  padding: calc(112rpx + env(safe-area-inset-top)) 48rpx calc(72rpx + env(safe-area-inset-bottom));
  background: #ece5d7;
  box-sizing: border-box;
}

.login-backdrop { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
.login-overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(247, 242, 231, 0.78); pointer-events: none; }
.login-paper { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; opacity: 0.16; pointer-events: none; }
.login-brand, .login-state { position: relative; z-index: 1; }
.login-brand { display: flex; flex-direction: column; align-items: flex-start; max-width: 560rpx; padding: 28rpx 26rpx 30rpx; border-left: 6rpx solid #7c302c; background: rgba(251, 250, 246, 0.86); }
.login-kicker { margin-bottom: 20rpx; color: #315c49; font-size: 22rpx; }
.login-name { color: #222724; font-family: "Songti SC", "STSong", serif; font-size: 76rpx; font-weight: 600; line-height: 1.15; }
.login-rule { width: 68rpx; height: 2rpx; margin-top: 24rpx; background: #7c302c; }
.login-entry { margin-top: 18rpx; color: #686d68; font-size: 25rpx; }
.login-state { min-height: 140rpx; padding: 26rpx; background: rgba(251, 250, 246, 0.9); color: #686d68; font-size: 26rpx; box-sizing: border-box; }

.login-indicator {
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid #c8ccc9;
  border-top-color: #315e4c;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.login-error { display: block; color: #8b3128; }
.login-retry { width: 240rpx; height: 80rpx; margin: 28rpx 0 0; border-radius: 8rpx; background: #222724; color: #fff; font-size: 26rpx; line-height: 80rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
