<view class="page archives">
  <view class="archive-tools">
    <view class="search-field">
      <text class="search-icon">⌕</text>
      <input value="{{query}}" placeholder="搜索姓名、籍贯或职业" confirm-type="search" bindinput="onSearch" />
    </view>
    <scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filters__inner">
        <button wx:for="{{filters}}" wx:key="value" class="filter {{state === item.value ? 'filter--active' : ''}}" data-value="{{item.value}}" bindtap="selectFilter">{{item.label}}</button>
      </view>
    </scroll-view>
  </view>
  <view wx:if="{{loading}}" class="loading">正在载入档案</view>
  <empty-state wx:elif="{{error}}" title="档案加载失败" detail="{{error}}" action-label="重新加载" bind:action="load"></empty-state>
  <empty-state wx:elif="{{projects.length === 0}}" title="没有找到档案" detail="可调整搜索条件或建立新档案"></empty-state>
  <block wx:else>
    <project-row wx:for="{{projects}}" wx:key="id" project="{{item}}" bind:open="openProject"></project-row>
    <view wx:if="{{loadingMore}}" class="load-more">正在载入更多</view>
    <view wx:elif="{{!nextCursor}}" class="list-end">已显示全部档案</view>
  </block>
</view>
<action-bar><button class="primary" bindtap="createProject">建立老人档案</button></action-bar>
