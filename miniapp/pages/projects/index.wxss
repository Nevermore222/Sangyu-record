.archives { background: var(--paper); padding-top: 20rpx; }
.archive-tools { position: sticky; top: 0; z-index: 5; padding: 4rpx 0 10rpx; background: rgba(251, 250, 246, 0.97); }
.search-field { display: flex; align-items: center; height: 82rpx; padding: 0 22rpx; border: 1rpx solid #d1d0ca; border-radius: 8rpx; background: #fff; box-sizing: border-box; }
.search-icon { margin-right: 14rpx; color: var(--muted); font-size: 34rpx; }
.search-field input { flex: 1; min-width: 0; font-size: 27rpx; }
.filters { width: 100%; margin: 20rpx 0 10rpx; white-space: nowrap; }
.filters__inner { display: inline-flex; gap: 12rpx; padding-right: 20rpx; }
.filter { width: auto; height: 60rpx; margin: 0; padding: 0 22rpx; border: 1rpx solid #d7d5ce; border-radius: 8rpx; background: #fff; color: var(--muted); font-size: 23rpx; line-height: 58rpx; }
.filter--active { border-color: var(--green); background: #edf2ef; color: var(--green); }
.load-more, .list-end { padding: 32rpx 0; color: #7b807c; font-size: 23rpx; text-align: center; }
