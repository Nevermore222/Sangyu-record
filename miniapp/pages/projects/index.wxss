.archives { background: #fff; padding-top: 20rpx; }
.archive-tools { position: sticky; top: 0; z-index: 5; padding-top: 4rpx; background: #fff; }
.search-field { display: flex; align-items: center; height: 80rpx; padding: 0 22rpx; border: 1rpx solid #cfd3cf; border-radius: 6rpx; box-sizing: border-box; }
.search-icon { margin-right: 14rpx; color: #656b66; font-size: 34rpx; }
.search-field input { flex: 1; min-width: 0; font-size: 27rpx; }
.filters { width: 100%; margin: 20rpx 0 10rpx; white-space: nowrap; }
.filters__inner { display: inline-flex; gap: 12rpx; padding-right: 20rpx; }
.filter { width: auto; height: 60rpx; margin: 0; padding: 0 22rpx; border: 1rpx solid #d7dad7; border-radius: 6rpx; background: #fff; color: #656b66; font-size: 23rpx; line-height: 58rpx; }
.filter--active { border-color: #315e4c; background: #eef3f0; color: #315e4c; }
.load-more, .list-end { padding: 32rpx 0; color: #7b807c; font-size: 23rpx; text-align: center; }
