.create-page { background: var(--paper); }
.step-head { padding: 8rpx 0 12rpx; }
.step-count { color: var(--muted); font-size: 22rpx; }
.step-track { height: 4rpx; margin-top: 12rpx; background: #deddd6; }
.step-fill { height: 100%; background: var(--burgundy); transition: width 180ms ease; }
.picker-value { display: flex; align-items: center; justify-content: space-between; min-height: 64rpx; }
.consent-copy { padding: 28rpx 24rpx 34rpx; border-top: 2rpx solid var(--green); border-bottom: 1rpx solid var(--line); background: #fff; color: #4f5550; font-size: 27rpx; line-height: 1.8; }
.consent-options { display: block; margin-top: 24rpx; }
.consent-option { display: flex; align-items: center; min-height: 126rpx; border-bottom: 1rpx solid var(--line); }
.consent-option radio { margin-right: 20rpx; transform: scale(0.85); }
.form-error { margin-top: 28rpx; color: var(--burgundy); font-size: 25rpx; line-height: 1.6; }
