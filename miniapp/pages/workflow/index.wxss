.workflow-page { background: var(--paper); }
.workflow-list { margin-top: 12rpx; }
.workflow-stage { display: flex; min-height: 104rpx; }
.stage-axis { position: relative; width: 48rpx; }
.stage-axis::after { content: ""; position: absolute; top: 30rpx; bottom: -30rpx; left: 14rpx; width: 1rpx; background: var(--line); }
.workflow-stage:last-child .stage-axis::after { display: none; }
.stage-dot { position: relative; z-index: 1; width: 28rpx; height: 28rpx; margin-top: 18rpx; border: 4rpx solid #c7cbc8; border-radius: 50%; background: #fff; box-sizing: border-box; }
.stage-dot--info { border-color: var(--green); }
.stage-dot--success { border-color: var(--green); background: var(--green); }
.stage-dot--danger { border-color: var(--burgundy); background: var(--burgundy); }
.workflow-stage--active .stage-dot { box-shadow: 0 0 0 10rpx rgba(49, 94, 76, 0.12); }
.stage-copy { display: flex; align-items: flex-start; justify-content: space-between; flex: 1; min-width: 0; gap: 18rpx; padding: 14rpx 0 28rpx; border-bottom: 1rpx solid var(--line); }
.stage-label { color: #303531; font-size: 27rpx; line-height: 1.5; }
.workflow-error { margin-top: 28rpx; padding: 24rpx; border-top: 2rpx solid var(--burgundy); background: #fff; color: var(--burgundy); font-size: 25rpx; }
.workflow-error text { display: block; margin-top: 8rpx; }
