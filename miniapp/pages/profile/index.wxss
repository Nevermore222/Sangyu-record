.profile { background: var(--paper); }
.profile-head { display: flex; align-items: center; margin: 8rpx 0 20rpx; padding: 30rpx 24rpx; border: 1rpx solid var(--line); border-left: 6rpx solid var(--green); background: #fff; }
.profile-mark { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; border: 2rpx solid var(--green); border-radius: 50%; background: var(--paper-deep); color: var(--green); font-family: "Songti SC", serif; font-size: 38rpx; }
.profile-copy { margin-left: 24rpx; }
.profile-name { display: block; font-size: 34rpx; font-weight: 600; }
.profile-team { display: block; margin-top: 8rpx; color: var(--muted); font-size: 24rpx; }
.profile-row { display: flex; justify-content: space-between; gap: 24rpx; min-height: 104rpx; align-items: center; border-bottom: 1rpx solid var(--line); font-size: 27rpx; }
.profile-value { color: var(--muted); text-align: right; overflow-wrap: anywhere; }
