.bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  gap: 20rpx;
  min-height: 128rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #dddcd5;
  background: rgba(251, 250, 246, 0.97);
  box-shadow: 0 -8rpx 24rpx rgba(41, 45, 41, 0.04);
  box-sizing: border-box;
}
