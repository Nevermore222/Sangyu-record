.progress-steps { padding: 24rpx 0 30rpx; }
.progress-steps__copy { display: flex; justify-content: space-between; color: #656b66; font-size: 24rpx; }
.progress-steps__track { height: 8rpx; margin-top: 16rpx; overflow: hidden; border-radius: 4rpx; background: #e4e7e4; }
.progress-steps__fill { height: 100%; border-radius: 4rpx; background: #315e4c; transition: width 180ms ease; }
