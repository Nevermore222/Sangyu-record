API_DOMAIN=api.memoir.example.com
FILES_DOMAIN=files.memoir.example.com
ACME_EMAIL=ops@example.com

# DSN passwords must use URL-safe characters only: A-Z a-z 0-9 . _ ~ -
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
MINIO_ROOT_USER=CHANGE_ME_STORAGE_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_STORAGE_PASSWORD
S3_ACCESS_KEY=CHANGE_ME_APPLICATION_STORAGE_USER
S3_SECRET_KEY=CHANGE_ME_LONG_RANDOM_APPLICATION_STORAGE_PASSWORD
S3_BUCKET=sangyu-private
S3_REGION=us-east-1

SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
SESSION_TTL=12h
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=CHANGE_ME_WECHAT_APP_SECRET
STAFF_OPENID_ALLOWLIST=openid_collector_1,openid_collector_2

MEDIA_PROVIDER_URL=https://media-provider.example.com
MEDIA_PROVIDER_TOKEN=CHANGE_ME_MEDIA_TOKEN
KNOWLEDGE_PROVIDER_URL=https://knowledge-provider.example.com
KNOWLEDGE_PROVIDER_TOKEN=CHANGE_ME_KNOWLEDGE_TOKEN
AGENT_PROVIDER_URL=https://agent-provider.example.com
AGENT_PROVIDER_TOKEN=CHANGE_ME_AGENT_TOKEN
PROVIDER_ALLOWED_HOSTS=media-provider.example.com:443,knowledge-provider.example.com:443,agent-provider.example.com:443
PROVIDER_CALLBACK_SECRET=CHANGE_ME_LONG_RANDOM_CALLBACK_SECRET
PROVIDER_POLL_INTERVAL=5s
